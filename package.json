{
  "name": "pi-adam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal pi quality-of-life extension.",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "oxlint",
    "test": "node --test features/*.test.ts herdr/todos/*.test.js herdr/app/*/*.test.js",
    "typecheck": "tsc"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "26.2.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
  }
}
